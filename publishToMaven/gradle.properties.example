# Merge into your project root gradle.properties (same folder as settings.gradle.kts).

MAVEN_PUBLISH_GROUP=io.github.yourusername
MAVEN_PUBLISH_VERSION=1.0.0

# Gradle subproject names to publish (module folder names), comma-separated.
MAVEN_PUBLISH_MODULES=mylibrary
# Optional: Maven artifactId if it should differ from the Gradle project name
# MAVEN_PUBLISH_ARTIFACT_ID=toastx

MAVEN_PUBLISH_POM_NAME=My Library
MAVEN_PUBLISH_POM_DESCRIPTION=Android library
MAVEN_PUBLISH_POM_URL=https://github.com/yourusername/yourrepo
MAVEN_PUBLISH_LICENSE_NAME=The Apache License, Version 2.0
MAVEN_PUBLISH_LICENSE_URL=https://www.apache.org/licenses/LICENSE-2.0.txt
MAVEN_PUBLISH_DEVELOPER_ID=yourusername
MAVEN_PUBLISH_DEVELOPER_NAME=Your Name
MAVEN_PUBLISH_DEVELOPER_URL=https://github.com/yourusername
MAVEN_PUBLISH_SCM_URL=https://github.com/yourusername/yourrepo
MAVEN_PUBLISH_SCM_CONNECTION=scm:git:git://github.com/yourusername/yourrepo.git
MAVEN_PUBLISH_SCM_DEV_CONNECTION=scm:git:ssh://git@github.com/yourusername/yourrepo.git
MAVEN_PUBLISH_INCEPTION_YEAR=2025

MAVEN_PUBLISH_FOLDER_REPO=build/maven-repo
MAVEN_PUBLISH_SIGNING=true

# Central: use publish-central.sh (or -PSONATYPE_HOST=CENTRAL_PORTAL -PSONATYPE_AUTOMATIC_RELEASE=true).
# Avoid SONATYPE_* in this file for daily dev unless you need it on every configuration.

# --- Do not put secrets in this project file. Use ~/.gradle/gradle.properties ---
# How to obtain each value: see publishToMaven/SIMPLE.md
#
# mavenCentralUsername=   → Sonatype Central Portal → Generate User Token (username field)
# mavenCentralPassword=   → same token (password field, not your login password)
#
# signing.keyId=          → gpg --list-secret-keys --keyid-format LONG  (key id hex)
# signing.password=       → passphrase from gpg --full-generate-key
# signing.secretKeyRingFile= → absolute path to exported secret key file, e.g. gpg --export-secret-keys KEY_ID > ~/secring.gpg
